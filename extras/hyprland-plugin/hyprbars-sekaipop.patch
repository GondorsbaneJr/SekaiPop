diff --git a/hyprbars/wantsSSD.cpp b/hyprbars/wantsSSD.cpp
new file mode 100644
index 0000000..35d325c
--- /dev/null
+++ b/hyprbars/wantsSSD.cpp
@@ -0,0 +1,48 @@
+// SekaiPop: does a Wayland window ask the compositor to draw its decorations?
+// Two protocols: xdg-decoration (Qt, kitty, Chromium/CEF...) and KDE's older
+// server-decoration (GTK3). Hyprland keeps both in private members; this file opens them up
+// (their dependencies are included first, so the access change only hits these headers).
+#include <any>
+#include <cstdint>
+#include <functional>
+#include <unordered_map>
+#include <vector>
+#include <hyprland/src/protocols/WaylandProtocol.hpp>
+#include <hyprland/protocols/xdg-decoration-unstable-v1.hpp>
+#include <hyprland/protocols/kde-server-decoration.hpp>
+#define private public
+#include <hyprland/src/protocols/XDGDecoration.hpp>
+#include <hyprland/src/protocols/ServerDecorationKDE.hpp>
+#undef private
+#include <hyprland/src/protocols/XDGShell.hpp>
+#include <hyprland/src/desktop/view/window/Window.hpp>
+
+#include "wantsSSD.hpp"
+
+// What Hyprland told the app (it honours the app's own request), so this is "the app
+// will draw no decorations of its own".
+bool windowWantsServerSideDecorations(PHLWINDOW window) {
+    if (!window || window->backend().isX11())
+        return false;
+
+    if (PROTO::xdgDecoration) {
+        for (const auto& [toplevelRes, deco] : PROTO::xdgDecoration->m_decorations) {
+            if (!deco || !toplevelRes)
+                continue;
+            const auto TOPLEVEL = CXDGToplevelResource::fromResource(toplevelRes);
+            if (!TOPLEVEL || TOPLEVEL->m_window.lock() != window)
+                continue;
+            return deco->mostRecentlySent == ZXDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE;
+        }
+    }
+
+    if (PROTO::serverDecorationKDE) {
+        const auto SURF = window->backend().surface();
+        for (const auto& deco : PROTO::serverDecorationKDE->m_decos) {
+            if (deco && SURF && deco->m_surf == SURF)
+                return deco->m_mostRecentlySent == ORG_KDE_KWIN_SERVER_DECORATION_MODE_SERVER;
+        }
+    }
+
+    return false; // never asked: the app draws its own (or none)
+}
